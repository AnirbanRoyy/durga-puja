# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Dashboard → API Keys)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login
ADMIN_PASSWORD=
# Long random strings, e.g. `bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
ADMIN_SESSION_SECRET=
VOTER_HASH_SECRET=

# Public site origin used for SEO (canonical URLs, sitemap). https://sodepur-durga-puja.vercel.app
NEXT_PUBLIC_SITE_URL=https://sodepur-durga-puja.vercel.app

# Upstash Redis (REST) - stops repeat registrations from one network. Optional: unset = no check.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Automatic English -> Bengali uses free services (no key needed). Optional: an email raises the
# free MyMemory fallback quota; TRANSLATION_DISABLED=1 switches translation off.
TRANSLATE_CONTACT_EMAIL=
TRANSLATION_DISABLED=
